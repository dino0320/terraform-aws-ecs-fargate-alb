account_id = "123456789012"
region     = "ap-northeast-1"
profile    = "my-profile"

app_name = "my-nginx-app"
env      = "dev"

availability_zones = [
  "ap-northeast-1a",
  "ap-northeast-1c",
  "ap-northeast-1d"
]

vpc_cidr = "172.32.0.0/16"

public_subnet_cidrs = [
  "172.32.0.0/20",
  "172.32.16.0/20",
  "172.32.32.0/20"
]
private_subnet_cidrs = [
  "172.32.48.0/20",
  "172.32.64.0/20",
  "172.32.80.0/20"
]

web_port = 80